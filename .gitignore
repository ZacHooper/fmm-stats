# Save files — large, personal, never commit
*.fms

# Extraction outputs (regenerate with extract.py)
output/

# DuckDB stores — DERIVED, never committed. They rewrite wholesale on every import (96 MiB
# for fm-frem, within 4 MiB of GitHub's hard per-file limit), so versioning them poisoned
# history: .git hit 257 MB, ~250 MB of it 19 copies of these two files. Rebuild instead:
#   uv run python scripts/rebuild.py --career frem
# The recipe is seeds/manifest.csv (in git) + the saves in R2. See docs/agent-context/.
*.duckdb
*.duckdb.wal
# pre-migration store backups — big, local, regenerable by re-importing the saves
backups/

# Local tooling / editor — but DO track the project skills so they travel with the repo.
.claude/*
!.claude/skills/
# …except developing-with-streamlit, which is a symlink into .venv (a skill shipped by the
# streamlit pip package, not ours — it reappears on any machine after `uv sync`).
.claude/skills/developing-with-streamlit

# Live state mirrored from R2 (shortlist, saved scouts) — one object per entry, synced with
# rclone. Machine-local cache of a shared bucket, so never committed.
state/

# Cloudflare / Streamlit local secrets — MUST stay out of git.
.streamlit/secrets.toml
.wrangler/

# Local experiments / scratch / personal junk — not part of the shareable project.
scratch/
visualizer/
IMG_*.PNG
Screenshot*.png
extra-findings-from-ffmvibe.txt

# Python
__pycache__/
*.pyc

# macOS
.DS_Store
